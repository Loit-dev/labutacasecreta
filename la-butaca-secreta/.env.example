# Copia este archivo a .env.local (y configura lo mismo en Vercel → Settings → Environment Variables)

# Token de lectura de la API de TMDb (Bearer): https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Opcionales (estos son los valores por defecto)
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p/w500

# Login (Supabase): Project Settings → API en supabase.com
# Son públicas por diseño (se usan en el navegador); sin ellas la web
# funciona igual que siempre, solo sin login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
